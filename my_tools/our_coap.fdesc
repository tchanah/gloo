enum8 T_udpmod_msg_type
{
    request 0
}


struct T_udpmod_header
{
    byte_order little_endian;
    uint16 collective_id;
    uint8 collective_type;
    uint8 operation;
    uint8 reserved0;
    uint8 reserved1;
    uint8 max_level;
    uint8 current_level;
    uint32 chunk_index;
    uint32 total_chunks;
}

struct T_udpmod_msg
{
    T_udpmod_header header;
    float32[256] data;
}

switch T_custom_switch # T_udpmod_msg_type
{
    default :  T_udpmod_msg "";
}
